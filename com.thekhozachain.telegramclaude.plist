<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.thekhozachain.telegramclaude</string>
    <key>ProgramArguments</key>
    <array>
        <string>/PATH/TO/telegram_claude/venv/bin/python3</string>
        <string>/PATH/TO/telegram_claude/run.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/PATH/TO/telegram_claude</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/PATH/TO/telegram_claude/bot.log</string>
    <key>StandardErrorPath</key>
    <string>/PATH/TO/telegram_claude/bot.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
